#!/bin/sh
set -e
if [ "$1" = "configure" ]; then
    modprobe uinput 2>/dev/null || true
    if command -v udevadm >/dev/null 2>&1; then
        udevadm control --reload-rules 2>/dev/null || true
        udevadm trigger --subsystem-match=misc --sysname-match=uinput 2>/dev/null || true
    fi
    cat <<'MSG'

Ponte installato.
  1) ponte init --mode server            (sul PC con mouse e tastiera)
     ponte init --mode client --server IP --secret SEGRETO   (sull'altro)
  2) Se questo PC fa da SERVER serve leggere /dev/input:
       sudo usermod -aG input $USER   e poi esci e rientra
  3) Avvio automatico:  systemctl --user enable --now ponte

MSG
fi
exit 0
